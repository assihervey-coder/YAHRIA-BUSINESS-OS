# YAHRIA BUSINESS OS — Environment template
# Copy to .env and fill with your own values. NEVER commit the real .env.

# SQLite (dev) — path to the local database file
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Ed25519/HMAC secret used to sign Evidence (INV-007 Event Immutability).
# Generate with: openssl rand -hex 32
EVIDENCE_SIGNING_KEY=replace_me_with_openssl_rand_hex_32
